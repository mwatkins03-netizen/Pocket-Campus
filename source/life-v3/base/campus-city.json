  "notes": [
    {
      "title": "Campus extent",
      "text": "A 600 m square of the historic core and Grove. The stadium, western campus, and outlying university properties are beyond this scene.",
      "links": [
        {
          "label": "Campus landscape",
          "url": "https://www.tclf.org/university-mississippi"
        }
      ]
    },
    {
      "title": "Landmark studies",
      "text": "Custom models of the Lyceum, Circle halls, observatories, and Fulton Chapel use mapped footprints and published descriptions. Details and heights without measurements are interpreted.",
      "links": [
        {
          "label": "Historic district survey",
          "url": "https://www.apps.mdah.ms.gov/nom/dist/200.pdf"
        },
        {
          "label": "University buildings",
          "url": "https://catalog.olemiss.edu/university/buildings.pdf"
        }
      ]
    },
    {
      "title": "A place in civil rights history",
      "text": "James Meredith\u2019s enrollment in 1962 is central to the historic district\u2019s significance. The scene depicts everyday campus life.",
      "links": [
        {
          "label": "MDAH district history",
          "url": "https://www.apps.mdah.ms.gov/Public/district.aspx?id=200&view=facts"
        }
      ]
    },
    {
      "title": "Measured and illustrative",
      "text": "50 mapped building footprints and mapped streets/paths; 45 buildings lack mapped heights. Colours, fa\u00e7ade details, trees, furniture, weather, people, and trips are illustrative. Special scenes evoke events rather than reproduce a particular date.",
      "links": [
        {
          "label": "OpenStreetMap data license",
          "url": "https://www.openstreetmap.org/copyright"
        },
        {
          "label": "Climate",
          "url": "https://www.geosciences.msstate.edu/state-climatologist/mississippi-climate"
        },
        {
          "label": "Tree context",
          "url": "https://www.tclf.org/university-mississippi"
        }
      ]
    },
    {
      "title": "Explore the wider campus",
      "text": "Use the campus-wide atlas for searchable main-campus buildings, playing fields, and streets beyond the miniature.",
      "links": [
        {
          "label": "Campus-wide map",
          "url": "campus-overview.html"
        }
      ]
    },
    {
      "title": "Architectural detail pass",
      "text": "Fa\u00e7ades now distinguish arched and sash windows, stone lintels, cornices, gallery railings, column orders, and roof forms. Main elevations were compared with photographs. Minor dimensions and unseen elevations remain interpreted.",
      "links": [
        {
          "label": "County courthouse photograph",
          "url": "https://lafayettems.com/places/lafayette-county-courthouse/"
        },
        {
          "label": "University building photographs",
          "url": "https://www.university-grounds.com/home/university-of-mississippi"
        },
        {
          "label": "Brevard restoration",
          "url": "https://www.mccartycompany.com/projects/brevard-hall"
        }
      ]
    }
  ],
