  "notes": [
    {
      "title": "The town square",
      "text": "A 300 m square rotated 10\u00b0 clockwise from north. The courthouse and Lyric remain whole inside the plot.",
      "links": [
        {
          "label": "OpenStreetMap",
          "url": "https://www.openstreetmap.org/#map=18/34.36637/-89.51871"
        }
      ]
    },
    {
      "title": "Courthouse study",
      "text": "The custom model includes paired porticoes, arcaded bases, and a domed clock cupola. The mapped outline supplies the plan; unmeasured proportions are interpreted.",
      "links": [
        {
          "label": "MDAH architectural survey",
          "url": "https://www.apps.mdah.ms.gov/nom/prop/31421.pdf"
        }
      ]
    },
    {
      "title": "Books and music",
      "text": "Mapped shop names identify the commercial streets. Storefronts and the Lyric model are simplified interpretations. Shop listings reflect OpenStreetMap and may be outdated.",
      "links": [
        {
          "label": "The Lyric",
          "url": "https://thelyricoxford.com/about/"
        },
        {
          "label": "Historic Square",
          "url": "https://oxfordms.com/about-oxford/oxford-culture/historic-oxford-square/"
        }
      ]
    },
    {
      "title": "Measured and illustrative",
      "text": "62 mapped building footprints and mapped streets/paths; 52 buildings lack mapped heights. Colours, fa\u00e7ade details, trees, furniture, weather, people, and trips are illustrative. Special scenes evoke events rather than reproduce a particular date.",
      "links": [
        {
          "label": "OpenStreetMap data license",
          "url": "https://www.openstreetmap.org/copyright"
        },
        {
          "label": "Climate",
          "url": "https://www.geosciences.msstate.edu/state-climatologist/mississippi-climate"
        },
        {
          "label": "Tree context",
          "url": "https://www.tclf.org/university-mississippi"
        }
      ]
    },
    {
      "title": "Courthouse landscape",
      "text": "The octagonal lawn, shade trees, and entrance paths are approximate additions based on photographs; they are not a tree or landscape survey.",
      "links": [
        {
          "label": "Historic courthouse photographs",
          "url": "https://www.apps.mdah.ms.gov/nom/prop/31421.pdf"
        }
      ]
    },
    {
      "title": "Explore the wider campus",
      "text": "Use the campus-wide atlas for searchable main-campus buildings, playing fields, and streets beyond the miniature.",
      "links": [
        {
          "label": "Campus-wide map",
          "url": "campus-overview.html"
        }
      ]
    },
    {
      "title": "Architectural detail pass",
      "text": "Fa\u00e7ades now distinguish arched and sash windows, stone lintels, cornices, gallery railings, column orders, and roof forms. Main elevations were compared with photographs. Minor dimensions and unseen elevations remain interpreted.",
      "links": [
        {
          "label": "County courthouse photograph",
          "url": "https://lafayettems.com/places/lafayette-county-courthouse/"
        },
        {
          "label": "University building photographs",
          "url": "https://www.university-grounds.com/home/university-of-mississippi"
        },
        {
          "label": "Brevard restoration",
          "url": "https://www.mccartycompany.com/projects/brevard-hall"
        }
      ]
    }
  ],
